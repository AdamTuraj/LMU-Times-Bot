# LMU Times Bot backend reverse proxy (include inside nginx's http context).
# Replace api.example.com with your public hostname.
# Bind the backend to HOST=127.0.0.1 and PORT=8000 in Backend/.env.
# Start with HTTP, then enable HTTPS using Certbot as described in README.md.
server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    location / {
        # Preserve all API paths, including /discord/callback.
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # This template assumes nginx is the public-facing proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
